---
import Base from "../layouts/Base.astro";
import { site } from "../data/site";

const formatDate = (ym: string) => {
  const [y, m] = ym.split("-").map(Number);
  if (!m) return String(y);
  return new Date(y, m - 1).toLocaleDateString("en-US", { month: "long", year: "numeric" });
};

const articles = [...site.articles].sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""));
const showTalks = site.talks.length > 0;

const nav = [
  { href: "#writing", label: "Writing" },
  { href: "#tools", label: "Tools" },
  ...(showTalks ? [{ href: "#speaking", label: "Speaking" }] : []),
  { href: "#about", label: "About" },
  ...(site.links.email ? [{ href: site.links.email, label: "Email" }] : []),
];

const year = new Date().getFullYear();
const sectionTitle = "font-serif text-3xl sm:text-4xl text-ink";
const card = "rounded-2xl border border-line bg-card p-6 sm:p-7 transition-colors";
const linkOut =
  "inline-flex items-center gap-1 font-medium text-accent underline decoration-accent/30 underline-offset-4 hover:decoration-accent";
---

<Base>
  <header class="sticky top-0 z-10 border-b border-line bg-paper/90 backdrop-blur">
    <nav class="mx-auto max-w-5xl px-5 py-4" aria-label="Main">
      <ul class="flex gap-5 overflow-x-auto text-sm text-muted sm:justify-end sm:gap-6">
        {nav.map((n) => <li><a href={n.href} class="whitespace-nowrap hover:text-accent">{n.label}</a></li>)}
      </ul>
    </nav>
  </header>

  <section id="top" class="mx-auto max-w-5xl px-5">
    <div class="grid items-center gap-10 py-10 md:min-h-[calc(100svh-4.5rem)] md:grid-cols-[1.15fr_0.85fr] md:gap-14 md:py-16">
      <div class="relative mx-auto w-full max-w-sm md:order-last md:max-w-none">
        <div class="absolute -bottom-4 -right-4 h-full w-full rounded-[2rem] bg-accent-soft" aria-hidden="true"></div>
        {
          site.headshot ? (
            <img
              src={site.headshot}
              alt={`Portrait of ${site.name}`}
              width="1200"
              height="1500"
              class="relative aspect-[4/5] w-full rounded-[2rem] object-cover shadow-sm"
            />
          ) : (
            <div class="relative flex aspect-[4/5] w-full items-center justify-center rounded-[2rem] bg-card font-serif text-6xl text-accent">
              IH
            </div>
          )
        }
      </div>
      <div>
        <p class="font-serif text-2xl italic text-accent sm:text-3xl">{site.greeting}</p>
        <h1 class="mt-3 font-serif text-5xl leading-[1.05] text-ink sm:text-6xl lg:text-7xl">{site.name}</h1>
        <p class="mt-4 text-sm font-medium uppercase tracking-[0.14em] text-muted">{site.role}</p>
        <p class="mt-6 max-w-xl text-xl leading-relaxed text-ink/85">{site.tagline}</p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="#writing" class="rounded-full bg-accent px-6 py-3 font-medium text-paper transition-opacity hover:opacity-90">
            Read my writing
          </a>
          <a
            href={site.links.linkedin}
            target="_blank"
            rel="noopener"
            class="rounded-full border border-ink/20 px-6 py-3 font-medium text-ink transition-colors hover:border-accent hover:text-accent"
          >
            Connect on LinkedIn
          </a>
        </div>
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-3xl px-5">
    <section id="writing" class="border-t border-line py-16">
      <h2 class={sectionTitle}>Writing</h2>
      <div class="mt-8 grid gap-5">
        {
          articles.map((a) => (
            <article class={`${card} hover:border-accent/50`}>
              <p class="text-sm text-muted">
                {a.outlet}
                {a.date && (
                  <>
                    {" · "}
                    <time datetime={a.date}>{formatDate(a.date)}</time>
                  </>
                )}
              </p>
              <h3 class="mt-2 font-serif text-xl leading-snug text-ink sm:text-2xl">{a.title}</h3>
              <p class="mt-3 text-muted">{a.summary}</p>
              <a href={a.url} class={`${linkOut} mt-4`} target="_blank" rel="noopener">
                {a.linkLabel ?? `Read at ${a.outlet}`} <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    <section id="tools" class="border-t border-line py-16">
      <h2 class={sectionTitle}>Tools</h2>
      <div class="mt-8 grid gap-5">
        {
          site.tools.map((t) => (
            <article class={`${card} hover:border-accent/50`}>
              <h3 class="font-serif text-xl text-ink sm:text-2xl">{t.name}</h3>
              <p class="mt-3 text-muted">{t.description}</p>
              <a href={t.url} class={`${linkOut} mt-4`} target="_blank" rel="noopener">
                Open {t.name} <span aria-hidden="true">→</span>
              </a>
            </article>
          ))
        }
      </div>
    </section>

    {
      showTalks && (
        <section id="speaking" class="border-t border-line py-16">
          <h2 class={sectionTitle}>Speaking</h2>
          <ul class="mt-8 grid gap-5">
            {site.talks.map((t) => (
              <li class={card}>
                <span class="inline-block rounded-full bg-accent-soft px-3 py-1 text-xs font-medium uppercase tracking-wide text-accent">
                  {t.status === "upcoming" ? "Upcoming" : "Presented"}
                </span>
                <h3 class="mt-3 font-serif text-xl leading-snug text-ink">{t.title}</h3>
                <p class="mt-2 text-muted">{t.event}</p>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section id="about" class="border-t border-line py-16">
      <h2 class={sectionTitle}>About</h2>
      <div class="mt-8 space-y-4 text-lg text-ink/90">
        {site.about.map((p) => <p>{p}</p>)}
      </div>
    </section>
  </main>

  <footer class="border-t border-line">
    <div class="mx-auto flex max-w-5xl flex-col gap-2 px-5 py-8 text-sm text-muted sm:flex-row sm:justify-between">
      <p>© {year} {site.name}</p>
      <div class="flex gap-5">
        {site.links.email && <a href={site.links.email} class="hover:text-accent">Email</a>}
        <a href={site.links.linkedin} class="hover:text-accent" target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </div>
  </footer>
</Base>
